{
    "scopeName": "source.fraze",
    "name": "Fraze",
    "fileTypes": [ "fz" ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.fraze",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.fraze",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.fraze",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.fraze",
                            "match": "\\\\[\\\"\\\\ntrbf]"
                        },
                        {
                            "name": "constant.character.escape.unicode.fraze",
                            "match": "\\\\u[0-9A-Fa-f]{4}"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.binary.fraze",
                    "match": "\\b0[bB](?:_?[01])+\\b"
                },
                {
                    "name": "constant.numeric.hex.fraze",
                    "match": "\\b0[xX](?:_?[0-9A-Fa-f])+\\b"
                },
                {
                    "name": "constant.numeric.float.fraze",
                    "match": "\\b\\d(?:_?\\d)*\\.\\d(?:_?\\d)*(?:[eE][+\\-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.float.fraze",
                    "match": "\\b\\d(?:_?\\d)*(?:[eE][+\\-]?\\d+)\\b"
                },
                {
                    "name": "constant.numeric.integer.decimal.fraze",
                    "match": "\\b\\d(?:_?\\d)*\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.declaration.fraze",
                    "match": "\\b(?:class|interface|functor|struct|enum)\\b"
                },
                {
                    "name": "storage.modifier.fraze",
                    "match": "\\b(?:extern|static|private)\\b"
                },
                {
                    "name": "keyword.control.fraze",
                    "match": "\\b(?:assert|if|else|for|return|while|goto|code)\\b"
                },
                {
                    "name": "keyword.other.fraze",
                    "match": "\\b(?:as|is|new|sizeof|await|fold|get|set|section|expose|operator)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.fraze",
                    "match": "\\b(?:object|bool|int|num|string|void)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.fraze",
                    "match": "(?:\\&\\?|==|!=|<=|>=|<<=|>>=|\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|&&|\\|\\||[+\\-*/%<>=!&|^~?:])"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.comma.fraze",
                    "match": ","
                },
                {
                    "name": "punctuation.terminator.statement.fraze",
                    "match": ";"
                },
                {
                    "name": "punctuation.accessor.dot.fraze",
                    "match": "\\."
                },
                {
                    "name": "punctuation.section.block.begin.fraze",
                    "match": "\\{"
                },
                {
                    "name": "punctuation.section.block.end.fraze",
                    "match": "\\}"
                },
                {
                    "name": "punctuation.section.parens.begin.fraze",
                    "match": "\\("
                },
                {
                    "name": "punctuation.section.parens.end.fraze",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.section.brackets.begin.fraze",
                    "match": "\\["
                },
                {
                    "name": "punctuation.section.brackets.end.fraze",
                    "match": "\\]"
                },
                {
                    "name": "punctuation.definition.generic.begin.fraze",
                    "match": "<"
                },
                {
                    "name": "punctuation.definition.generic.end.fraze",
                    "match": ">"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "entity.name.function.fraze",
                    "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.fraze"
                        }
                    }
                },
                {
                    "name": "variable.other.fraze",
                    "match": "\\b[A-Za-z_$][\\w$]*\\b"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "variable.language.this.fraze",
                    "match": "\\bthis\\b"
                },
                {
                    "name": "constant.language.boolean.true.fraze",
                    "match": "\\btrue\\b"
                },
                {
                    "name": "constant.language.boolean.false.fraze",
                    "match": "\\bfalse\\b"
                },
                {
                    "name": "constant.language.null.fraze",
                    "match": "\\bnull\\b"
                }
            ]
        }
    },
    "injectionSelector": "L:source.fraze",
    "uuid": "7f30d2e2-0c88-4d1f-8aa9-fraze-tm"
