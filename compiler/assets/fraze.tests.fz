section OperatorTests
{
    void Run()
    {
        int a = 3;
        int b;
        int c;

        b = a + 2;
        assert(b == 5);

        b += 2;
        assert(b == 7);

        c = ++b;
        assert(b == 8);
        assert(c == 8);

        c = b++;
        assert(b == 9);
        assert(c == 8);

        b = b - 2;
        assert(b == 7);

        b -= 2;
        assert(b == 5);

        c = --b;
        assert(b == 4);
        assert(c == 4);

        c = b--;
        assert(b == 3);
        assert(c == 4);

        b = a * 2;
        assert(b == 6);

        b *= 2;
        assert(b == 12);

        b = b / 2;
        assert(b == 6);

        b /= 2;
        assert(b == 3);

        b = 10 % 6;
        assert(b == 4);

        b %= 3;
        assert(b == 1);

        a = 1 << 1;
        assert(a == 2);

        a <<= 1;
        assert(a == 4);

        a = a >> 1;
        assert(a == 2);
        
        a >>= 1;
        assert(a == 1);

        a = a | 2;
        assert(a == 3);

        a |= 4;
        assert(a == 7);

        a = 0b1111;
        a = a & 0b1101;
        assert(a == 0b1101);

        a &= 0b0101;
        assert(a == 0b0101);

        assert(a &? 0b0001 == true);
        assert(a &? 0b0010 == false);

        a = 0b1111 ^ 0b1010;
        assert(a == 0b0101);

        a ^= 0b1100;
        assert(a == 0b1001);

        a = ~a & 0b1111;
        assert(a == 0b0110);

        bool x = true;
        bool y = false;
        assert((x && y) == false);
        assert(!x == false);
        assert(!y == true);
        
        a = x ? 1 : 2;
        assert(a == 1);

        a = y ? 1 : 2;
        assert(a == 2);

        assert(1 == 1);
        assert(1 != 2);
        assert(1 < 2);
        assert(2 <= 2);
        assert(2 > 1);
        assert(2 >= 2);
    }
}

section ConversionTests
{
    class Test
    {
        int value = 111;
    }

    functor void TestFunctor();

    void TestFunc()
    {
    }

    enum TestEnum
    {
        One,
        Two
    }

    void Run()
    {
        // implicit boxing and conversion to object
        bool L1 = true;
        object R1 = L1;
        assert(R1 is bool);
        assert(R1 as bool == L1);

        int L2 = 5;
        object R2 = L2;
        assert(R2 is int);
        assert(R2 as int == L2);

        num L3 = 5.0;
        object R3 = L3;
        assert(R3 is num);
        assert(R3 as num == L3);

        string L4 = "a";
        object R4 = L4;
        assert(R4 is string);
        assert(R4 as string == L4);

        Test L5 = new Test{};
        object R5 = L5;
        assert(R5 is Test);
        assert(R5 as Test == L5);

        TestFunctor L6 = TestFunc;
        object R6 = L6;
        assert(R6 as TestFunctor == L6);

        // string concat
        string L7 = "a=" + true;
        assert(L7 == "a=true");

        string L8 = "a=" + 1;
        assert(L8 == "a=1");

        string L9 = "a=" + 0.5;
        assert(L9 == "a=0.5");

        string L10 = "a=" + "a";
        assert(L10 == "a=a");

        string L11 = "a=";
        L11 += true;
        assert(L11 == "a=true");

        string L12 = "a=";
        L12 += 1;
        assert(L12 == "a=1");

        string L13 = "a=";
        L13 += 0.5;
        assert(L13 == "a=0.5");

        string L14 = "a=";
        L14 += "a";
        assert(L14 == "a=a");

        // int -> num promotion
        num L15 = 1;
        assert(L15 == 1.0);

        num L16 = 1 + 0.5;
        assert(L16 == 1.5);

        num L17 = 0.5 + 1;
        assert(L17 == 1.5);

        // explicit unboxing and conversion from object
        object L18 = true;
        bool R18 = L18 as bool;
        assert(R18 == true);

        object L19 = 1;
        int R19 = L19 as int;
        assert(R19 == 1);

        object L20 = 1.5;
        num R20 = L20 as num;
        assert(R20 == 1.5);

        Test T21 = new Test{};
        object L21 = T21;
        Test R21 = L21 as Test;
        assert(R21 == T21);

        int[] T22 = new int[1];
        object L22 = T22;
        int[] R22 = L22 as int[];
        assert(R22 == T22);

        string T23 = "a";
        object L23 = T23;
        string R23 = L23 as string;
        assert(R23 == T23);

        TestFunctor T24 = TestFunc;
        object L24 = T24;
        TestFunctor R24 = L24 as TestFunctor;
        assert(R24 == T24);

        // explicit conversion to object
        int[] L25 = new int[1];
        object R25 = L25 as object;
        assert(L25 == R25);

        string L26 = "a";
        object R26 = L26 as object;
        assert(L26 == R26);

        Test L27 = new Test{};
        object R27 = L27 as object;
        assert(L27 == R27);

        // explicit conversion between int and num
        int L28 = 2;
        num R28 = L28 as num;
        assert(R28 == 2.0);

        num L29 = 1.5;
        int R29 = L29 as int;
        assert(R29 == 1);

        // conversion to string
        int L30 = 111;
        string R30 = L30 as string;
        assert(R30 == "111");

        num L31 = 1.5;
        string R31 = L31 as string;
        assert(R31 == "1.5");

        bool L32 = false;
        string R32 = L32 as string;
        assert(R32 == "false");

        // type checks
        assert(true is bool);
        assert(1 is int);
        assert(0.5 is num);
        assert(new int[1] is int[]);
        assert("a" is string);
        assert(new Test{} is Test);
        TestFunctor T33 = TestFunc;
        assert(T33 is TestFunctor);
        assert((T33 as object) is TestFunctor);

        assert((false as object) is bool);
        assert((1 as object) is int);
        assert((0.5 as object) is num);
        assert((new int[1] as object) is int[]);
        assert(("a" as object) is string);
        assert((new Test{} as object) is Test);
        
        // check (x is null) comparisons
        object L34 = null;
        assert(L34 is null);
        assert(!(L34 is Test));

        Test L35;
        assert(L35 is null);
        assert(L35 is Test == false);

        Test L36 = new Test{};
        assert(L36 is null == false);
        assert(L36 is Test);

        num L37 = 1.5;
        int R37 = L37 as int;
        assert(R37 == 1);

        int L38 = 2;
        num R38 = L38 as num;
        assert(R38 == 2.0);

        int L39 = 1;
        bool R39 = L39 as bool;
        assert(R39 == true);

        // check enum conversions
        TestEnum L40 = TestEnum.One;
        int R40 = L40 as int;
        assert(R40 == 0);

        TestEnum L41 = TestEnum.Two;
        string R41 = L41 as string;
        assert(R41 == "Two");
    }
}

section ArrayTests
{
    void Run()
    {
        int[] numbers = new int[]{ 1, 2, 3 };
        
        for(int i = 0; i != numbers.Count; ++i)
        {
            assert(numbers[i] == i + 1);
        }
    }
}

section StringTests
{
    enum TestEnum
    {
        One,
        Two
    }

    void Run()
    {
        string s1 = "Hello" + " " + "World" + " " + 100;
        assert(s1 == "Hello World 100");

        string s2 = "Hello";
        s2 += " ";
        s2 += "World";
        s2 += " ";
        s2 += 100;
        assert(s2 == "Hello World 100");

        string test = "one,two,three,four";
        string[] parts = String.Split(test, ",");
        assert(parts[0] == "one");
        assert(parts[1] == "two");
        assert(parts[2] == "three");
        assert(parts[3] == "four");

        string s3 = "Value: " + TestEnum.One;
        assert(s3 == "Value: One");
    }
}

section ContainerTests
{
    struct CustomKey
    {
        string value;
    }

    int GetHashCode(CustomKey key) {
        return String.GetHashCode(key.value);
    }

    void Run()
    {
        // list
        List<int> list = new List<int>{};
        list.Add(123);
        list.Add(456);
        list.Add(789);
        assert(list.Count == 3);
        list.RemoveAt(1);
        assert(list.Count == 2);
        assert(list[0] == 123);
        assert(list[1] == 789);
        list.Add(111);
        list.Add(222);
        list.RestockAt(1);
        assert(list[1] == 222);

        for(int i = 0; i != list.Count; ++i)
        {
            int oldValue = list[i];
            list[i] += 111;
            int newValue = list[i];
            assert(newValue == oldValue + 111);
        }

        list.Clear();
        assert(list.Count == 0);

        // table
        var table1 = new Table<string, string>{};
        table1["one"] = "1";
        table1["two"] = "2";
        table1["three"] = "3";
        table1["four"] = "4";
        assert(table1.Count == 4);
        assert(table1["one"] == "1");
        assert(table1["two"] == "2");
        assert(table1["three"] == "3");
        assert(table1["four"] == "4");
        assert(table1.Contains("two"));
        assert(!table1.Contains("five"));

        table1.Remove("two");
        assert(!table1.Contains("two"));
        assert(table1.Count == 3);
        
        table1.Remove("four");
        assert(table1.Count == 2);
        assert(!table1.Contains("four"));
        
        table1.Clear();
        assert(table1.Count == 0);

        var table2 = new Table<num, string>{};
        table2[1] = "one";
        table2[2] = "two";
        table2[3] = "three";
        assert(table2[1] == "one");
        assert(table2[2] == "two");
        assert(table2[3] == "three");

        var table3 = new Table<CustomKey, string>{};

        var key1 = new CustomKey{ "one" };
        var key2 = new CustomKey{ "two" };
        var key3 = new CustomKey{ "three" };

        table3[key1] = "one";
        table3[key2] = "two";
        table3[key3] = "three";
        assert(table3[key1] == "one");
        assert(table3[key2] == "two");
        assert(table3[key3] == "three");
    }
}

section TemplateTests
{
    class Money<Units>
    {
        Units amount;
    }

    class Wallet<MoneyType>
    {
        MoneyType money = new MoneyType{};
    }

    class TemplateProperties<T>
    {
        private T _value;

        T Value {
            get { return _value; }
            set { _value = value; }
        }
    }

    void Run()
    {
        Wallet<Money<num>> wallet = new Wallet<Money<num>>{};
        wallet.money.amount = 5.50;

        TemplateProperties<int> test1 = new TemplateProperties<int>{};
        test1.Value = 123;
        assert(test1.Value == 123);

        TemplateProperties<num> test2 = new TemplateProperties<num>{};
        test2.Value = 123.456;
        assert(test2.Value == 123.456);

        TemplateProperties<string> test3 = new TemplateProperties<string>{};
        test3.Value = "Hello World";
        assert(test3.Value == "Hello World");
    }
}

section TemplateFunctionTests
{
    class Widget
    {
        int id = 7;
    }

    T Identity<T>(T value) {
        return value;
    }

    T[] Repeat<T>(T value, int count)
    {
        T[] items = new T[count];

        for(int i = 0; i != count; ++i)
            items[i] = value;

        return items;
    }

    List<T> MakeList<T>(T first, T second)
    {
        List<T> list = new List<T>{};
        list.Add(first);
        list.Add(second);
        return list;
    }

    T Create<T>() {
        return new T{};
    }

    V Second<U, V>(U first, V second) {
        return second;
    }

    int Depth<T>(T value, int n)
    {
        if(n <= 0)
            return 0;

        return 1 + Depth<T>(value, n - 1);
    }

    int Describe(int value) {
        return 1;
    }

    int Describe<T>(T value) {
        return 2;
    }

    // an overload of the template above: both instantiate to "Describe<int>"
    int Describe<T>(T value, T other) {
        return 3;
    }

    class Box
    {
        int calls = 0;

        T Echo<T>(T value) {
            ++calls;
            return value;
        }

        static T StaticEcho<T>(T value) {
            return value;
        }
    }

    struct Pair
    {
        int a;
        int b;

        T Pick<T>(T first, T second, bool useFirst) {
            return useFirst ? first : second;
        }
    }

    class Holder<T>
    {
        T value;

        U Echo<U>(U other) {
            return other;
        }
    }

    void Run()
    {
        // free functions
        assert(Identity<int>(123) == 123);
        assert(Identity<num>(1.5) == 1.5);
        assert(Identity<string>("abc") == "abc");

        // the existing instance is reused for repeated calls
        assert(Identity<int>(456) == 456);

        // arrays of a template parameter type
        int[] ints = Repeat<int>(9, 3);
        assert(ints.Count == 3);
        assert(ints[0] == 9);
        assert(ints[2] == 9);

        string[] strings = Repeat<string>("x", 2);
        assert(strings.Count == 2);
        assert(strings[1] == "x");

        // class templates instantiated from a function template
        List<int> list = MakeList<int>(1, 2);
        assert(list.Count == 2);
        assert(list[0] == 1);
        assert(list[1] == 2);

        // 'new' with a template parameter type
        Widget widget = Create<Widget>();
        assert(widget.id == 7);

        // multiple template parameters
        assert(Second<int, string>(1, "two") == "two");
        assert(Second<string, num>("one", 2.5) == 2.5);

        // recursive instantiation
        assert(Depth<string>("a", 3) == 3);

        // non-template overloads are used when no template arguments are given
        assert(Describe(1) == 1);
        assert(Describe<int>(1) == 2);
        assert(Describe<int>(1, 2) == 3);
        assert(Describe<string>("a") == 2);

        // class member functions
        Box box = new Box{};
        assert(box.Echo<int>(5) == 5);
        assert(box.Echo<string>("five") == "five");
        assert(box.calls == 2);
        assert(Box.StaticEcho<int>(6) == 6);

        // struct member functions
        Pair pair = new Pair{ 1, 2 };
        assert(pair.Pick<int>(10, 20, true) == 10);
        assert(pair.Pick<string>("a", "b", false) == "b");

        // template functions inside class templates
        Holder<int> holder = new Holder<int>{};
        holder.value = 42;
        assert(holder.value == 42);
        assert(holder.Echo<num>(1.25) == 1.25);

        // nested template arguments at a call site
        List<int> copy = Identity<List<int>>(list);
        assert(copy.Count == 2);
        assert(copy[1] == 2);

        // '<' that does not begin a template argument list is still a comparison
        int a = 1;
        int b = 2;
        assert(a < b);
        assert(a < b + 1);
        assert(a < (b));
        assert(!(b < a));
    }
}

section InterfaceTests
{
    interface Interface1 {
        int One();
    }

    interface Interface2 {
        int Two();
    }

    interface Interface3<T> {
        int Value(T value);
    }

    class ImplementationA : Interface1, Interface2, Interface3<int> {
        int One() { return 1; }
        int Two() { return 2; }
        int Value(int value) { return value; }
    }

    class ImplementationB : Interface1, Interface2, Interface3<int> {
        int One() { return 11; }
        int Two() { return 22; }
        int Value(int value) { return value * 11; }
    }

    void Run()
    {
        ImplementationA implA = new ImplementationA{};
        ImplementationB implB = new ImplementationB{};
        
        Interface1 itf1;
        itf1 = implA;
        assert(itf1.One() == 1);
        itf1 = implB;
        assert(itf1.One() == 11);
        implB = itf1 as ImplementationB;

        Interface2 itf2;
        itf2 = implA;
        assert(itf2.Two() == 2);
        itf2 = implB;
        assert(itf2.Two() == 22);

        Interface3<int> itf3;
        itf3 = implA;
        assert(itf3.Value(3) == 3);
        itf3 = implB;
        assert(itf3.Value(3) == 33);
    }
}

section StructTests
{
    struct Point
    {
        num x;
        num y;
        num z;

        Point Self() {
            return this;
        }

        static num SumOf(Point p) {
            return p.x + p.y + p.z;
        }

        num Sum() {
            return SumOf(this);
        }
    }

    void Run()
    {
        Point point1 = new Point{ 1, 2, 3 };
        assert(point1.x == 1);
        assert(point1.y == 2);
        assert(point1.z == 3);

        Point point2;
        point2.x = 777;
        point2.y = 888;
        point2.z = 999;
        assert(point2.x == 777);
        assert(point2.y == 888);
        assert(point2.z == 999);

        Point[] points1 = new Point[]{
            new Point{ 1, 2, 3 },
            new Point{ 4, 5, 6 },
            new Point{ 7, 8, 9 }
        };
        assert(points1[0].x == 1);
        assert(points1[0].y == 2);
        assert(points1[0].z == 3);
        assert(points1[1].x == 4);
        assert(points1[1].y == 5);
        assert(points1[1].z == 6);
        assert(points1[2].x == 7);
        assert(points1[2].y == 8);
        assert(points1[2].z == 9);

        Point[] points2 = new Point[3];
        points2[0] = new Point{ 1, 2, 3 };
        points2[1] = new Point{ 4, 5, 6 };
        points2[2] = new Point{ 7, 8, 9 };
        assert(points2[0].x == 1);
        assert(points2[0].y == 2);
        assert(points2[0].z == 3);
        assert(points2[1].x == 4);
        assert(points2[1].y == 5);
        assert(points2[1].z == 6);
        assert(points2[2].x == 7);
        assert(points2[2].y == 8);
        assert(points2[2].z == 9);

        points2[0].x = 111;
        points2[1].y = 222;
        points2[2].z = 333;
        assert(points2[0].x == 111);
        assert(points2[1].y == 222);
        assert(points2[2].z == 333);

        // TODO: add struct equality tests

        Point point3 = point1.Self();
        assert(point3.x == 1);
        assert(point3.y == 2);
        assert(point3.z == 3);
        assert(point1.Sum() == 6);
    }
}

section FunctorTests
{
    void TestFunc()
    {
    }

    class Test
    {
        int value1;
        static int value2 = 567;

        int Func1()
        {
            return value1;
        }

        static int Func2()
        {
            return value2;
        }
    }

    functor void TestFunctor1();
    functor int TestFunctor2();

    void Run()
    {
        // free function pointer
        TestFunctor1 fun1 = TestFunc;
        fun1();
        
        // member function pointer
        Test test = new Test{};
        test.value1 = 123;
        TestFunctor2 fun2 = test.Func1;
        assert(fun2() == test.value1);

        // static member function pointer
        TestFunctor2 fun3 = Test.Func2;
        assert(fun3() == Test.value2);

        // capture local variable by value
        int value = 123;
        
        TestFunctor2 fun4 = functor int() {
            int capturedValue = value;
            return capturedValue;
        };

        assert(fun4() == value);
    }
}

class TopLevelAcc
{
    int total;

    // a member coroutine on a class declared outside any section
    Task<int> BumpAsync(int amount)
    {
        await WaitAsync(0.01);
        total += amount;
        return total;
    }
}

section AsyncTests
{
    // NOTE: the operands around an 'await' are spilled into fields of the coroutine's task, so
    // suspending discards nothing and an 'await' can sit anywhere in an expression. An operand of
    // '&&', '||' or a ternary becomes a branch of an if statement, keeping the short circuit. The
    // positions left out are a loop condition, an assignment target, the right of a compound
    // assignment, and inside a fold. See SemanticAnalyzer::SpillAwaits.

    // a non-static member coroutine: the receiver is captured by the coroutine
    // state object and is used to reach fields and methods across suspension points
    class Accumulator
    {
        int total;

        int Add(int amount) {
            total += amount;
            return total;
        }

        Task<int> AccumulateAsync(int amount)
        {
            // a local declared before a suspension point is hoisted into the
            // coroutine state object, so it must survive the suspension
            int before = total;
            await WaitAsync(0.01);
            total = before + amount;
            return total;
        }

        Task<int> AccumulateTwiceAsync(int amount)
        {
            // implicit receiver for a nested member coroutine
            int once = await AccumulateAsync(amount);
            // explicit receiver for a nested member coroutine
            int twice = await this.AccumulateAsync(amount);
            assert(once + amount == twice);
            // a plain (non-coroutine) member call from within a coroutine
            assert(Add(0) == twice);
            return twice;
        }
    }

    void Run()
    {
        AsyncFunc1();
        MemberCoroutineTest();
        MultiAwaitTest();
        SpilledAwaitTest();
        AwaitPositionTest();
        ShortCircuitAwaitTest();
    }

    int awaitCount = 0;

    Task<bool> CountedFlagAsync(bool value) { awaitCount += 1; await YieldAsync(); return value; }
    Task<int> CountedValueAsync(int value) { awaitCount += 1; await YieldAsync(); return value; }

    // an operand of '&&', '||' or a ternary runs only sometimes, so its await lowers into a branch
    Task<void> ShortCircuitAwaitTest()
    {
        // '&&' awaits its right side only when the left is true
        awaitCount = 0;
        bool andTaken = true && await CountedFlagAsync(true);
        assert(andTaken);
        assert(awaitCount == 1);

        awaitCount = 0;
        bool andSkipped = false && await CountedFlagAsync(true);
        assert(!andSkipped);
        assert(awaitCount == 0);

        // '||' awaits its right side only when the left is false
        awaitCount = 0;
        bool orSkipped = true || await CountedFlagAsync(false);
        assert(orSkipped);
        assert(awaitCount == 0);

        awaitCount = 0;
        bool orTaken = false || await CountedFlagAsync(true);
        assert(orTaken);
        assert(awaitCount == 1);

        // a ternary awaits only the arm it takes
        awaitCount = 0;
        int fromTrue = true ? await CountedValueAsync(1) : await CountedValueAsync(2);
        assert(fromTrue == 1);
        assert(awaitCount == 1);

        awaitCount = 0;
        int fromFalse = false ? await CountedValueAsync(1) : await CountedValueAsync(2);
        assert(fromFalse == 2);
        assert(awaitCount == 1);

        // a condition always runs, so an await in one lowers ahead of the branches
        awaitCount = 0;
        bool fromCondition = await CountedFlagAsync(true) && true;
        assert(fromCondition);
        assert(awaitCount == 1);

        int fromComparison = await ValueAsync(5) > 3 ? 10 : 20;
        assert(fromComparison == 10);

        // chained, and nested inside a larger expression
        awaitCount = 0;
        bool chained = await CountedFlagAsync(true) && await CountedFlagAsync(true) || await CountedFlagAsync(false);
        assert(chained);
        assert(awaitCount == 2);

        int sum = (true ? await ValueAsync(3) : 0) + (false ? 0 : await ValueAsync(4));
        assert(sum == 7);
    }

    int tally = 0;

    int Count(int value) {
        tally += value;
        return value;
    }

    struct Pair
    {
        int a;
        int b;
        int Sum() { return a + b; }
    }

    struct Counter
    {
        int total;
        void Add(int v) { total += v; }
    }

    class Holder
    {
        int value;
        int Doubled() { return value * 2; }
        void Bump(int v) { value += v; }
    }

    Task<bool> FlagAsync(bool value) { await YieldAsync(); return value; }
    Task<string> TextAsync(string value) { await YieldAsync(); return value; }
    Task<Holder> HolderAsync(int value) { await YieldAsync(); return new Holder{ value }; }
    Task<Pair> PairAsync(int a, int b) { await YieldAsync(); return new Pair{ a, b }; }
    Task<int[]> NumbersAsync() { await YieldAsync(); return new int[]{ 5, 6, 7 }; }

    // the expression positions an await can be spilled out of
    Task<void> AwaitPositionTest()
    {
        // an index, and a write through one
        int[] numbers = new int[]{ 10, 11, 12 };
        assert(numbers[await ValueAsync(2)] == 12);
        numbers[1] = await ValueAsync(3);
        assert(numbers[1] == 3);

        // 'await' binds tighter than the arithmetic around it
        assert(await ValueAsync(3) * 2 + 1 == 7);
        assert(2 * await ValueAsync(3) == 6);

        // a prefix operator applies to the awaited value, not to the expression it came from
        assert(-await ValueAsync(3) == -3);
        assert(!await FlagAsync(false));
        assert(~await ValueAsync(0) == -1);
        assert(-await ValueAsync(3) + 10 == 7);

        // a member, a method, Count and an index, all on an awaited value
        assert((await HolderAsync(4)).value == 4);
        assert((await HolderAsync(5)).Doubled() == 10);
        assert((await NumbersAsync()).Count == 3);
        assert((await NumbersAsync())[1] == 6);

        // an awaited struct is spilled into a field, which its address can be taken from
        assert((await PairAsync(1, 2)).a == 1);
        assert((await PairAsync(3, 4)).Sum() == 7);

        // a receiver the caller already had stays an l-value, so a mutation still lands on it
        Counter counter = new Counter{ 1 };
        counter.Add(await ValueAsync(5));
        assert(counter.total == 6);

        Holder holder = new Holder{ 2 };
        holder.Bump(await ValueAsync(7));
        assert(holder.value == 9);

        Pair pair = new Pair{ 0, 0 };
        pair.b = await ValueAsync(20);
        assert(pair.Sum() + await ValueAsync(100) == 120);

        // an await inside the expression another await is awaiting
        assert(await ValueAsync(await ValueAsync(6)) == 6);

        // initializer arguments of a struct, a class and an array
        Pair made = new Pair{ await ValueAsync(7), await ValueAsync(8) };
        assert(made.a == 7);
        assert(made.b == 8);

        Holder built = new Holder{ await ValueAsync(9) };
        assert(built.value == 9);

        int[] listed = new int[]{ await ValueAsync(1), await ValueAsync(2) };
        assert(listed[0] == 1);
        assert(listed[1] == 2);

        // a string operand and a bool result
        assert("a" + await TextAsync("b") == "ab");
        assert(await FlagAsync(true));

        // three awaits in one call, each keeping its own value
        assert(Mix3(await ValueAsync(1), await ValueAsync(2), await ValueAsync(3)) == 123);
    }

    static int Mix3(int a, int b, int c) {
        return a * 100 + b * 10 + c;
    }

    // the operands around an await are spilled into the task, so they survive the suspension
    Task<void> SpilledAwaitTest()
    {
        assert(await ValueAsync(5) == 5);

        int sum = await ValueAsync(2) + await ValueAsync(3);
        assert(sum == 5);

        // the operands on either side of the await run in source order, before and after it
        tally = 0;
        int mixed = Mix3(Count(1), await ValueAsync(2), Count(3));
        assert(mixed == 123);
        assert(tally == 4);

        int[] values = new int[2];
        values[1] = await ValueAsync(7);
        assert(values[1] == 7);

        if(await ValueAsync(1) == 1)
            tally = 9;
        assert(tally == 9);

        switch(await ValueAsync(2))
        {
            case 2:
                tally = 20;
            default:
                tally = 0;
        }
        assert(tally == 20);

        int nested = await MixedReturnAsync();
        assert(nested == 456);
    }

    Task<int> MixedReturnAsync()
    {
        return Mix3(await ValueAsync(4), 5, 6);
    }

    Task<int> ValueAsync(int value)
    {
        await YieldAsync();
        return value;
    }

    // each pass resumes at the same await
    Task<int> LoopAsync(int count)
    {
        int n = 0;
        while(n < count)
        {
            await YieldAsync();
            n += 1;
        }
        return n;
    }

    // an await in the iterate statement, which is a statement like any other
    Task<int> IterateAsync(int count)
    {
        int total = 0;
        for(int i = 0; i < count; i = await ValueAsync(i + 1))
            total += i;
        return total;
    }

    // every place an await can be, each one resuming at its own state
    Task<int> SequenceAsync()
    {
        int a = await ValueAsync(1);
        var b = await ValueAsync(2);
        int c = 0;
        c = await ValueAsync(3);
        if(a + b + c == 6)
            await YieldAsync();
        return await ValueAsync(a + b + c);
    }

    Task<void> MultiAwaitTest()
    {
        int n = await LoopAsync(3);
        assert(n == 3);

        int sum = await SequenceAsync();
        assert(sum == 6);

        int total = await IterateAsync(4);
        assert(total == 6);
    }

    Task<void> MemberCoroutineTest()
    {
        // member coroutine on a section-nested class
        Accumulator acc = new Accumulator{};
        int total = await acc.AccumulateTwiceAsync(5);
        assert(total == 10);
        assert(acc.total == 10);

        // member coroutine on a top-level class
        TopLevelAcc top = new TopLevelAcc{};
        int bumped = await top.BumpAsync(3);
        assert(bumped == 3);
        assert(top.total == 3);
    }

    Task<void> AsyncFunc1()
    {
        string result = await AsyncFunc2("number: ", 5);
        assert(result == "number: 5");
    }

    Task<string> AsyncFunc2(string a, int b)
    {
        await WaitAsync(0.01);
        return a + b;
    }
}

// the receiver ("this") of a non-static member is passed as the implicit first
// argument, so these tests cover each way a receiver can be produced and consumed
section ReceiverTests
{
    class Counter
    {
        int count;
        Counter next;

        int Increment() {
            // implicit receiver
            count += 1;
            return count;
        }

        int IncrementExplicit() {
            // explicit receiver
            this.count += 1;
            return this.count;
        }

        int IncrementTwice() {
            // the receiver of a nested call is the current receiver
            Increment();
            return Increment();
        }

        Counter Chain() {
            // the receiver may be returned and used as the receiver of another call
            return this;
        }

        static int CountOf(Counter counter) {
            // the receiver may be forwarded as an ordinary argument
            return counter.count;
        }

        int CountViaStatic() {
            return CountOf(this);
        }
    }

    void Run()
    {
        Counter counter = new Counter{};
        assert(counter.Increment() == 1);
        assert(counter.IncrementExplicit() == 2);
        assert(counter.IncrementTwice() == 4);
        assert(counter.CountViaStatic() == 4);
        assert(Counter.CountOf(counter) == 4);

        // the receiver is an expression, not just a local
        assert(counter.Chain().Chain().Increment() == 5);

        // the receiver comes from a field
        counter.next = new Counter{};
        assert(counter.next.Increment() == 1);
        assert(counter.count == 5);

        // the receiver comes from an array element
        Counter[] counters = new Counter[]{ new Counter{}, new Counter{} };
        assert(counters[0].Increment() == 1);
        assert(counters[1].Increment() == 1);
        assert(counters[1].Increment() == 2);
        assert(counters[0].count == 1);
    }
}

// a struct receiver is passed by reference so that member functions can mutate
// the caller's storage, but the struct itself is still a value type
section StructReceiverTests
{
    struct Accumulator
    {
        int total;

        void Add(int amount) {
            // mutates the caller's storage through the implicit receiver
            total += amount;
        }

        void AddTwice(int amount) {
            // a nested call forwards the same receiver, so it also mutates the caller
            Add(amount);
            Add(amount);
        }

        Accumulator Copy() {
            // the receiver is dereferenced to produce a value
            return this;
        }

        static int TotalOf(Accumulator acc) {
            // 'acc' is a by-value copy, so mutating it cannot affect the caller
            acc.total = -1;
            return acc.total;
        }

        int TotalViaStatic() {
            return TotalOf(this);
        }

        int Total {
            get { return total; }
            set { total = value; }
        }
    }

    class Holder
    {
        Accumulator acc;
    }

    static Accumulator MakeAccumulator(int total) {
        return new Accumulator{ total };
    }

    void Run()
    {
        // a local receiver is mutated in place
        Accumulator acc = new Accumulator{ 1 };
        acc.Add(2);
        assert(acc.total == 3);
        acc.AddTwice(10);
        assert(acc.total == 23);

        // property accessors take a receiver too
        acc.Total = 5;
        assert(acc.Total == 5);
        assert(acc.total == 5);

        // 'this' returned from a struct member is a copy, not an alias
        Accumulator copy = acc.Copy();
        copy.Add(1);
        assert(copy.total == 6);
        assert(acc.total == 5);

        // passing 'this' to a by-value parameter must copy
        assert(acc.TotalViaStatic() == -1);
        assert(acc.total == 5);

        // assignment copies, so the copy has an independent receiver
        Accumulator assigned = acc;
        assigned.Add(100);
        assert(assigned.total == 105);
        assert(acc.total == 5);

        // a struct field of a class is mutated in place
        Holder holder = new Holder{};
        holder.acc.Add(7);
        holder.acc.Add(7);
        assert(holder.acc.total == 14);

        // a struct array element is mutated in place
        Accumulator[] accs = new Accumulator[2];
        accs[0].Add(3);
        accs[1].Add(4);
        accs[1].Add(4);
        assert(accs[0].total == 3);
        assert(accs[1].total == 8);

        // an r-value receiver has no stable address, so it is stored in a temporary first
        assert(MakeAccumulator(9).Copy().total == 9);
        assert(MakeAccumulator(9).Total == 9);
    }
}

// a functor is the receiver of its own 'invoke' function, including when the
// functor expression is not a plain identifier
section CallableTests
{
    functor int IntFunctor(int value);

    class Adder
    {
        int amount;

        int Add(int value) {
            return value + amount;
        }

        IntFunctor Callback;

        IntFunctor GetAdder() {
            return Add;
        }
    }

    static int Double(int value) {
        return value * 2;
    }

    static IntFunctor GetDoubler() {
        return Double;
    }

    static IntFunctor[] GetFunctors() {
        return new IntFunctor[]{ Double, Double };
    }

    void Run()
    {
        // a functor bound to a member function keeps its own receiver
        Adder adder = new Adder{};
        adder.amount = 10;
        IntFunctor bound = adder.Add;
        assert(bound(1) == 11);

        // a functor held in a field is called through the field
        Adder withCallback = new Adder{ 0, Double };
        assert(withCallback.Callback(4) == 8);

        // a function assigned (rather than used as an initializer) to a functor
        IntFunctor reassigned;
        reassigned = Double;
        assert(reassigned(4) == 8);
        reassigned = adder.Add;
        assert(reassigned(4) == 14);
        withCallback.Callback = adder.Add;
        assert(withCallback.Callback(4) == 14);

        // a member function used as a value infers 'this' as its receiver
        assert(adder.GetAdder()(5) == 15);

        // the callee is returned by a function, so the call target is not an identifier
        assert(GetDoubler()(3) == 6);
        assert(adder.GetAdder()(5) == 15);

        // the callee is an array element, so the call target is not an identifier
        IntFunctor[] functors = new IntFunctor[]{ Double, Double };
        assert(functors[0](6) == 12);
        assert(GetFunctors()[1](7) == 14);

        // a functor literal is called through a local
        IntFunctor tripler = functor int(int value) {
            return value * 3;
        };
        assert(tripler(3) == 9);
    }
}

// a virtual call reads its type from the receiver, which is now the first argument
section VirtualReceiverTests
{
    interface IShape {
        int Sides();
        int DoubleSides();
    }

    class Triangle : IShape
    {
        int Sides() { return 3; }

        // dispatches through the receiver from inside a member function
        int DoubleSides() { return Sides() * 2; }
    }

    class Square : IShape
    {
        int Sides() { return 4; }
        int DoubleSides() { return Sides() * 2; }
    }

    static int SidesOf(IShape shape) {
        return shape.Sides();
    }

    void Run()
    {
        IShape shape = new Triangle{};
        assert(shape.Sides() == 3);
        assert(shape.DoubleSides() == 6);
        assert(SidesOf(shape) == 3);

        shape = new Square{};
        assert(shape.Sides() == 4);
        assert(shape.DoubleSides() == 8);
        assert(SidesOf(shape) == 4);

        // the receiver comes from an array element of interface type
        IShape[] shapes = new IShape[]{ new Triangle{}, new Square{} };
        assert(shapes[0].DoubleSides() == 6);
        assert(shapes[1].DoubleSides() == 8);
    }
}

// a fold expression is a block of statements in expression position. its final statement is
// an expression, which the fold yields and which gives the fold its type.
section FoldTests
{
    struct Vec
    {
        num x;
        num y;

        num Sum() {
            return x + y;
        }
    }

    functor int IntFunctor();

    class Counter
    {
        int count;

        int Bump(int amount) {
            count += amount;
            return count;
        }
    }

    static Vec MakeVec() {
        Vec v;
        v.x = 8;
        v.y = 9;
        return v;
    }

    static int Twice(int value) {
        return value * 2;
    }

    // instantiating the template clones the fold, whose final expression has to still find
    // the local it yields in the copied body's scope
    T CopyThroughFold<T>(T value) {
        return fold {
            T copy = value;
            copy;
        };
    }

    // 'return' inside a fold returns from the enclosing function, abandoning the rest of the
    // expression the fold is part of, including a call whose argument was already being built
    static int ReturnFromFold(int value) {
        int result = Twice(fold {
            if(value < 0)
                return -1;

            value;
        }) + 1;

        return result;
    }

    Task<int> FoldInCoroutineAsync(int amount)
    {
        // a fold in a coroutine, outside any suspension point ('await' inside a fold is an error)
        int scaled = fold {
            int doubled = amount * 2;
            doubled;
        };

        await WaitAsync(0.01);
        return scaled;
    }

    Task<void> CoroutineTest()
    {
        int scaled = await FoldInCoroutineAsync(21);
        assert(scaled == 42);
    }

    void Run()
    {
        // statements run before the final expression, which is the result
        int x = fold {
            int a = 1;
            a += 1;
            a;
        };
        assert(x == 2);

        // the type comes from the final expression, so a fold can yield any type
        string text = fold { string s = "ab"; s + "c"; };
        assert(text == "abc");

        num scaled = fold { num n = 1.5; n * 2.0; };
        assert(scaled == 3.0);

        // branches assign a local that the final expression yields, since 'if' is a statement
        string message = fold {
            string m;

            if(x == 1)
                m = "one";
            else if(x == 2)
                m = "two";
            else
                m = "many";

            m;
        };
        assert(message == "two");

        // a fold nested in the body of another fold
        int nested = fold {
            int inner = fold { 6; };
            inner * 7;
        };
        assert(nested == 42);

        // a struct result is yielded by value
        Vec vec = fold {
            Vec v;
            v.x = 3;
            v.y = 4;
            v;
        };
        assert(vec.x == 3);
        assert(vec.y == 4);

        // a struct fold used as a receiver is passed by reference
        num sum = fold {
            Vec v;
            v.x = 10;
            v.y = 5;
            v;
        }.Sum();
        assert(sum == 15);

        // an r-value result has no address of its own, so a fold used as a receiver
        // stores it in a temp first, the same way a plain r-value receiver does
        assert(new Vec{ 8, 9 }.Sum() == 17);
        assert(MakeVec().Sum() == 17);
        assert(fold { new Vec{ 8, 9 }; }.Sum() == 17);
        assert(fold { MakeVec(); }.Sum() == 17);

        // the same fold yields the struct by value when nothing asks for its address
        Vec byValue = fold { new Vec{ 8, 9 }; };
        assert(byValue.x == 8);
        assert(byValue.y == 9);

        // a fold in a loop body, evaluated on each pass
        int total = 0;
        for(int i = 0; i != 4; ++i)
        {
            total += fold {
                int step = i % 2 == 0 ? i : 10;
                step;
            };
        }
        assert(total == 22); // 0 + 10 + 2 + 10

        assert(CopyThroughFold<int>(5) == 5);
        assert(CopyThroughFold<string>("five") == "five");
        assert(CopyThroughFold<Vec>(new Vec{ 1, 2 }).Sum() == 3);

        assert(ReturnFromFold(5) == 11);
        assert(ReturnFromFold(-5) == -1);

        // a fold as a call argument, and one nested in another fold's final expression
        assert(Twice(fold { 3; }) == 6);
        assert(Twice(fold { Twice(fold { 5; }); }) == 20);

        // a fold as the receiver of a class member call: the class reference is
        // pushed as-is, not by reference like a struct
        int bumped = fold {
            Counter counter = new Counter{};
            counter.count = 100;
            counter;
        }.Bump(5);
        assert(bumped == 105);

        // a fold result drives a condition and a ternary
        if(fold { x == 2; })
            total += 1;
        else
            total += 100;
        assert(total == 23);

        string label = fold { false; } ? "yes" : "no";
        assert(label == "no");

        // a functor body inside a fold keeps its own returns
        IntFunctor fun = fold {
            int captured = 7;

            IntFunctor inner = functor int() {
                // NOTE: 'captured' is read once because a functor that mentions the same
                // captured variable twice adds its capture member twice (see GetCaptures)
                int amount = captured;

                if(amount == 7)
                    return amount;

                return 0;
            };

            inner;
        };
        assert(fun() == 7);

        // a fold inside a functor body
        IntFunctor folding = functor int() {
            return fold {
                int a = 20;
                a + 1;
            };
        };
        assert(folding() == 21);

        // the bounds check evaluates a computed index into a temp fold and reads it back for
        // the element access, so the index is only evaluated once on both sides of an assignment
        int[] numbers = new int[]{ 10, 20, 30, 40 };
        int i = 1;
        assert(numbers[i + 1] == 30);
        assert(numbers[Twice(1)] == 30);

        numbers[i + 1] = 300;
        assert(numbers[2] == 300);

        numbers[Twice(1)] += 7;
        assert(numbers[2] == 307);

        ++numbers[i + 2];
        assert(numbers[3] == 41);

        // the index is evaluated exactly once, even though the check and the access both read it
        int calls = 0;
        int[] counts = new int[]{ 0, 0, 0 };
        counts[fold { calls += 1; 2; }] = 5;
        assert(calls == 1);
        assert(counts[2] == 5);

        // a struct element reached through a computed index
        Vec[] vectors = new Vec[]{ new Vec{ 1, 2 }, new Vec{ 3, 4 } };
        assert(vectors[i - 1].Sum() == 3);
        vectors[i * 1].x = 30;
        assert(vectors[1].x == 30);

        CoroutineTest();
    }
}

section GotoTests
{
    // a template instance clones the body, so its goto has to find the cloned label
    T Sum<T>(T[] values) {
        T total;
        int i = 0;
    loop:
        if(i == values.Count)
            goto done;
        total += values[i];
        ++i;
        goto loop;
    done:
        return total;
    }

    Task<int> CountAsync(int count)
    {
        // a coroutine's locals are fields, so jumping back past one is just a jump
        int n = 0;
    again:
        await YieldAsync();
        int next = n + 1;
        n = next;
        if(n < count)
            goto again;
        return n;
    }

    Task<void> CoroutineTest()
    {
        int n = await CountAsync(3);
        assert(n == 3);
    }

    void Run()
    {
        // forward over statements
        int x = 1;
        goto skip;
        x = 2;
    skip:
        assert(x == 1);

        // backward, jumping past a definition again, which reruns its initializer
        int sum = 0;
        int i = 0;
    top:
        int doubled = i * 2;
        sum += doubled;
        ++i;
        if(i < 4)
            goto top;
        assert(sum == 12);

        // out of nested loops
        int found = -1;
        for(int a = 0; a < 5; ++a)
        {
            for(int b = 0; b < 5; ++b)
            {
                if(a * b == 6)
                {
                    found = a * 10 + b;
                    goto foundIt;
                }
            }
        }
    foundIt:
        assert(found == 23);

        // into a block, to a label that ends it
        int entered = 0;
        goto inside;
        {
            entered = 1;
        inside:
        }
        assert(entered == 0);

        // within a fold
        int folded = fold {
            int n = 0;
        more:
            n += 5;
            if(n < 20)
                goto more;
            n;
        };
        assert(folded == 20);

        assert(Sum<int>(new int[]{ 1, 2, 3 }) == 6);
        assert(Sum<num>(new num[]{ 0.5, 0.25 }) == 0.75);

        CoroutineTest();
    }
}

section SwitchTests
{
    enum Color
    {
        Red,
        Green,
        Blue
    }

    // a negative member, which the ones after it count up from
    enum Offset
    {
        Back = -1,
        Here,
        Ahead
    }

    static int Steps(Offset offset) {
        switch(offset)
        {
            case Offset.Back:
                return -10;
            case Offset.Here:
                return 0;
            case Offset.Ahead:
                return 10;
        }
        return 99;
    }

    // dense, so it dispatches with a jump table
    static int Dense(int value) {
        int result = -1;
        switch(value)
        {
            case 0:
                result = 10;
            case 1:
                result = 11;
            case 3:
                result = 13;
            default:
                result = 99;
        }
        return result;
    }

    // negative cases shift the table
    static int Negative(int value) {
        int result = 0;
        switch(value)
        {
            case -2:
                result = 2;
            case -1:
                result = 1;
        }
        return result;
    }

    // too sparse for a table, so it compares against each case
    static int Sparse(int value) {
        int result = 0;
        switch(value)
        {
            case 1:
                result = 1;
            case 1000:
                result = 1000;
            case -100000:
                result = -100000;
            default:
                result = 7;
        }
        return result;
    }

    // stacked and listed labels share a section, and the default can share one too
    static string Shared(int value) {
        string result = "";
        switch(value)
        {
            case 1:
            case 2:
                result = "low";
            case 3, 4:
                result = "mid";
            case 5:
            default:
                result = "other";
        }
        return result;
    }

    static string Name(Color color) {
        switch(color)
        {
            case Color.Red:
                return "red";
            case Color.Green:
                return "green";
            case Color.Blue:
                return "blue";
        }
        return "";
    }

    // each section is its own scope, so they can reuse a name
    static int Scoped(int value) {
        switch(value)
        {
            case 0:
                int n = 5;
                return n;
            default:
                int n = 6;
                return n;
        }
        return 0;
    }

    // a goto leaves a section without the dispatched value left on the stack
    static int LeaveSection(int value) {
        int result = 0;
        switch(value)
        {
            case 0:
                result = 1;
                goto after;
            default:
                result = 2;
        }
        result += 10;
    after:
        return result;
    }

    Task<int> SwitchAsync(int value)
    {
        int result = 0;
        switch(value)
        {
            case 1:
                await YieldAsync();
                result = 10;
            default:
                // a return inside a section completes the task from there
                return 20;
        }
        return result;
    }

    Task<void> CoroutineTest()
    {
        int n = await SwitchAsync(1);
        assert(n == 10);

        int m = await SwitchAsync(9);
        assert(m == 20);
    }

    void Run()
    {
        assert(Dense(0) == 10);
        assert(Dense(1) == 11);
        assert(Dense(2) == 99);
        assert(Dense(3) == 13);
        assert(Dense(-1) == 99);
        assert(Dense(4) == 99);

        assert(Negative(-2) == 2);
        assert(Negative(-1) == 1);
        assert(Negative(0) == 0);
        assert(Negative(-3) == 0);

        assert(Sparse(1) == 1);
        assert(Sparse(1000) == 1000);
        assert(Sparse(-100000) == -100000);
        assert(Sparse(2) == 7);

        assert(Shared(1) == "low");
        assert(Shared(2) == "low");
        assert(Shared(3) == "mid");
        assert(Shared(4) == "mid");
        assert(Shared(5) == "other");
        assert(Shared(9) == "other");

        assert(Steps(Offset.Back) == -10);
        assert(Steps(Offset.Here) == 0);
        assert(Steps(Offset.Ahead) == 10);

        assert(Name(Color.Red) == "red");
        assert(Name(Color.Green) == "green");
        assert(Name(Color.Blue) == "blue");

        assert(Scoped(0) == 5);
        assert(Scoped(1) == 6);

        assert(LeaveSection(0) == 1);
        assert(LeaveSection(5) == 12);

        // the switch value is evaluated once, and nothing is left on the stack in a loop
        int calls = 0;
        int total = 0;
        for(int i = 0; i < 100; ++i)
        {
            switch(fold { calls += 1; i % 4; })
            {
                case 0:
                    total += 1;
                case 2:
                    total += 100;
            }

            switch(i * 1000)
            {
                case 0:
                    total += 10000;
            }
        }
        assert(calls == 100);
        assert(total == 25 + 2500 + 10000);

        // empty and default-only
        int untouched = 1;
        switch(untouched) { }
        assert(untouched == 1);

        switch(untouched)
        {
            default:
                untouched = 2;
        }
        assert(untouched == 2);

        CoroutineTest();
    }
}

void RunAllTests()
{
    OperatorTests.Run();
    ConversionTests.Run();
    ArrayTests.Run();
    StringTests.Run();
    ContainerTests.Run();
    TemplateTests.Run();
    TemplateFunctionTests.Run();
    InterfaceTests.Run();
    StructTests.Run();
    FunctorTests.Run();
    ReceiverTests.Run();
    StructReceiverTests.Run();
    CallableTests.Run();
    VirtualReceiverTests.Run();
    AsyncTests.Run();
    FoldTests.Run();
    GotoTests.Run();
    SwitchTests.Run();
}
