interface Awaiter
{
    void Resume();
}

interface Awaitable
{
    void SetAwaiter(Awaiter aw);
    void ResumeAwaiter();
}

interface Task<T>
{
    bool IsDone();
    T GetValue();
}

void OnAwaitableCompleted(Awaitable finishedTask)
{
    finishedTask.ResumeAwaiter();
}

extern Task<void> WaitAsync(num seconds);
extern Task<void> YieldAsync();
