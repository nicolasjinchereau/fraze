interface IPredicate
{
    bool IsMatch(object obj);
}

class Boolean
{
    bool value;
    extern static int GetHashCode(bool value);
}

class Integer
{
    int value;
    extern static int GetHashCode(int value);
}

class Number
{
    num value;
    extern static int GetHashCode(num value);
}

class String
{
    extern static int GetHashCode(string value);
    extern static string[] Split(string input, string delim);
    extern static string Concat(string left, string right);
    extern static bool Equals(string left, string right);
    extern static string FromBool(bool value);
    extern static string FromInt(int value);
    extern static string FromNum(num value);
    extern static string FromEnum(Type enumType, int value);
}

class Object
{
    extern static int GetHashCode(object value);
}

class Console
{
    extern static void Write(string msg);
    extern static void WriteLine(string msg);
}

class GC
{
    extern static void Collect();
    extern static void Report();
}

class Array
{
    extern static int GetCount(object arr);
    extern static int GetSize(object arr);

    static T[] CheckBounds<T>(T[] arr, int index, string message, string file, int line, int column, string lineText)
    {
        if(index < 0 || index >= GetCount(arr))
            Debug.Fail(message, file, line, column, lineText);
        return arr;
    }
}

extern class Type
{
    extern static Type Find(int typeID);
    extern static bool IsInstance(object obj, Type rightType);
    extern static object AsInstance(object obj, Type rightType);
    extern string GetName();
}

class Debug
{
    static void Assert(bool condition, string message, string file, int line, int column, string lineText)
    {
        if(!condition)
            Fail(message, file, line, column, lineText);
    }

    static T AssertNotNull<T>(T obj, string message, string file, int line, int column, string lineText)
    {
        if(obj == null)
            Fail(message, file, line, column, lineText);
        return obj;
    }

    static object CheckType(object obj, Type type, string message, string file, int line, int column, string lineText)
    {
        if(!Type.IsInstance(obj, type))
            Fail(message, file, line, column, lineText);
        return obj;
    }

    extern static void Fail(string message, string file, int line, int column, string lineText);
}
