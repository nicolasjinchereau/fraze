int Pick(int value)
{
    return value;
}

int Pick(bool value)
{
    return 20;
}

int Pick(num value)
{
    return 30;
}

int main()
{
    bool flag = true;
    num scale = 1.5;
    int result = Pick(7);

    result = Pick(flag);
    result = Pick(result);
    result = Pick(scale);

    return result;
}
