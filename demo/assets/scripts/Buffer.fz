enum BufferType
{
	Vertex,
	Index,
}

enum BufferUsage
{
	Default,
	Stream,
	Static,
	Dynamic
}

enum BufferCPUAccess
{
	None,
	ReadOnly,
	WriteOnly,
	ReadWrite
}

enum BufferMapAccess
{
	ReadOnly,
	WriteOnly,
	ReadWrite,
	WriteDiscard,
	WriteNoSync,
}

struct Vertex
{
    Vec3 pos;
    Vec2 tex;
    Vec3 norm;
}

extern class NativeBuffer
{
    extern this(object graphicsObj, BufferType type, BufferUsage usage, BufferCPUAccess cpuAccess, int size);
    extern this(object graphicsObj, BufferType type, BufferUsage usage, BufferCPUAccess cpuAccess, void[] data);
    extern void SetData(void[] dataArray);
    extern int GetSize();
    extern int GetStride();
}

class Buffer
{
    private NativeBuffer nativeBuffer;

	this(Graphics graphics, BufferType type, BufferUsage usage, BufferCPUAccess cpuAccess, int size) {
        nativeBuffer = new NativeBuffer{graphics.NativeHandle, type, usage, cpuAccess, size};
    }
	
	this(Graphics graphics, BufferType type, BufferUsage usage, BufferCPUAccess cpuAccess, void[] data) {
        nativeBuffer = new NativeBuffer{graphics.NativeHandle, type, usage, cpuAccess, data};
    }

	void SetData(void[] data) {
        nativeBuffer.SetData(data);
	}

	int Size {
		get { return nativeBuffer.GetSize(); }
	}

	int Stride {
		get { return nativeBuffer.GetStride(); }
	}

	object NativeHandle {
		get { return nativeBuffer; }
	}
}
