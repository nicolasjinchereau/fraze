enum PixelDataFormat
{
    Unspecified,
    Alpha8,
    RGB24,
    RGBA32,
    RGBAFloat
}

enum TextureWrapMode
{
    Clamp,
    Repeat,
}

enum TextureFilterMode
{
    Point,
    Bilinear,
    Trilinear,
}

class Texture
{
    private object nativeTexture;
    private extern object CreateNativeTexture(object graphicsObj, string path);
    private extern Task<object> CreateNativeTextureAsync(object graphicsObj, string path);

    this(Graphics graphics, string path)
    {
        nativeTexture = CreateNativeTexture(graphics.NativeGraphics, path);
    }

    static Task<Texture> CreateTextureAsync(Graphics graphics, string path)
    {
        object nativeTex = await Texture.CreateNativeTextureAsync(graphics.NativeGraphics, path);
        return new Texture{ nativeTex };
    }

    object NativeTexture {
        get { return nativeTexture; }
    }
}
