enum PixelDataFormat
{
    Unspecified,
    Alpha8,
    RGB24,
    RGBA32,
    RGBAFloat
}

enum TextureWrapMode
{
    Clamp,
    Repeat,
}

enum TextureFilterMode
{
    Point,
    Bilinear,
    Trilinear,
}

extern class NativeTexture
{
    extern this(object graphicsObj, string path);
}

class Texture
{
    private NativeTexture nativeTexture;
    private extern Task<NativeTexture> CreateNativeTextureAsync(object graphicsObj, string path);

    this(Graphics graphics, string path)
    {
        nativeTexture = new NativeTexture{graphics.NativeHandle, path};
    }

    static Task<Texture> CreateTextureAsync(Graphics graphics, string path)
    {
        NativeTexture nativeTex = await Texture.CreateNativeTextureAsync(graphics.NativeHandle, path);
        return new Texture{ nativeTex };
    }

    object NativeHandle {
        get { return nativeTexture; }
    }
}
