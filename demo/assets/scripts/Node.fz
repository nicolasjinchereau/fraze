struct Transform
{
    Vec3 pos;
    Quat rot;
    Vec3 scale;
}

class Node
{
    private Vec3 localPos = Vec3.Zero;
    private Quat localRot = Quat.Identity;
    private Vec3 localScale = Vec3.One;
    private Vec3 worldPos = Vec3.Zero;
    private Quat worldRot = Quat.Identity;
    private Vec3 worldScale = Vec3.One;
    private bool dirty = true;
    private bool active = true;
    private List<Node> children = new List<Node>{};
    private List<IComponent> components = new List<IComponent>{};
    private Node parent;
    private Scene scene;
    private string name;

    bool IsActive
    {
        get { return active; }
        set
        {
            if(active != value)
            {
                active = value;
                if(active)
                {
                    for(int i = 0; i != components.Count; ++i)
                        components[i].OnNodeActivated();
                }
                else
                {
                    for(int i = 0; i != components.Count; ++i)
                        components[i].OnNodeDeactivated();
                }
            }
        }
    }

    bool IsBranchActive
    {
        get { return active && (parent == null || parent.IsBranchActive); }
    }

    string Name
    {
        get { return name; }
        set { name = value; }
    }

    void SetDirty()
    {
        if(!dirty)
        {
            dirty = true;

            for(int i = 0; i != components.Count; ++i)
                components[i].OnTransformChanged();

            for(int i = 0; i != children.Count; ++i)
                children[i].SetDirty();
        }
    }

    void UpdateWorldTransform()
    {
        if(dirty)
        {
            if(parent)
            {
                parent.UpdateWorldTransform();

                Vec3 wpos = localPos;
                Quat wrot = localRot;
                Vec3 wscale = localScale;

                Vec3 parentScale = parent.worldScale;
                Quat parentRot = parent.worldRot;
                Vec3 parentPos = parent.worldPos;

                wpos = wpos.Multiply(parentScale);
                wpos *= parentRot;
                wpos += parentPos;

                wrot *= parentRot;

                wscale = wscale.Multiply(parentScale);

                worldPos = wpos;
                worldRot = wrot;
                worldScale = wscale;
            }
            else
            {
                worldPos = localPos;
                worldRot = localRot;
                worldScale = localScale;
            }

            dirty = false;
        }
    }

    void SetLocalTransform(Transform transform)
    {
        SetLocalTransform(transform.pos, transform.rot, transform.scale);
    }

    void SetLocalTransform(Vec3 pos, Quat rot, Vec3 scale)
    {
        localPos = pos;
        localRot = rot;
        localScale = scale;
        SetDirty();
    }

    void SetGlobalTransform(Vec3 pos, Quat rot, Vec3 scale)
    {
        if(parent)
        {
            Vec3 parentInvScale = Vec3.One.Divide(parent.Scale);
            Quat parentInvRot = parent.Rotation.Inverse;

            // position
            Vec3 lpos = pos;
            lpos -= parent.Position;
            lpos *= parentInvRot;
            lpos = lpos.Multiply(parentInvScale);
            localPos = lpos;

            // rotation
            localRot = rot * parentInvRot;

            // scale
            localScale = scale.Multiply(parentInvScale);
        }
        else
        {
            localPos = pos;
            localRot = rot;
            localScale = scale;
        }

        SetDirty();
    }

    Vec3 WorldToLocalPos(Vec3 pos)
    {
        Vec3 lpos = pos;

        if(parent)
        {
            lpos -= parent.Position;
            lpos *= parent.Rotation.Inverse;
            lpos = lpos.Divide(parent.Scale);
        }

        return lpos;
    }

    Vec3 LocalPosition
    {
        get { return localPos; }
        set
        {
            localPos = value;
            SetDirty();
        }
    }

    Vec3 LocalScale
    {
        get { return localScale; }
        set
        {
            localScale = value;
            SetDirty();
        }
    }

    Quat LocalRotation
    {
        get { return localRot; }
        set
        {
            localRot = value;
            SetDirty();
        }
    }

    Vec3 Position
    {
        get
        {
            UpdateWorldTransform();
            return worldPos;
        }
        set
        {
            localPos = WorldToLocalPos(value);
            SetDirty();
        }
    }

    Vec3 Scale
    {
        get
        {
            UpdateWorldTransform();
            return worldScale;
        }
        set
        {
            localScale = parent != null ? value.Divide(parent.Scale) : value;
            SetDirty();
        }
    }

    Quat Rotation
    {
        get
        {
            UpdateWorldTransform();
            return worldRot;
        }
        set
        {
            localRot = parent != null ? value * parent.Rotation.Inverse : value;
            SetDirty();
        }
    }
    
    List<IComponent> Components {
        get { return components; }
    }

    Vec3 Left { get { return Vec3.Left * Rotation; } }
    Vec3 Right { get { return Vec3.Right * Rotation; } }
    Vec3 Up { get { return Vec3.Up * Rotation; } }
    Vec3 Down { get { return Vec3.Down * Rotation; } }
    Vec3 Forward { get { return Vec3.Forward * Rotation; } }
    Vec3 Backward { get { return Vec3.Backward * Rotation; } }

    Mat4 LocalToWorldMatrix
    {
        get
        {
            Vec3 pos = Position;
            Quat rot = Rotation;
            Vec3 scale = Scale;

            Mat4 mtx = Mat4.FromMat3(rot.ToMatrix());

            mtx.m11 *= scale.x;
            mtx.m12 *= scale.x;
            mtx.m13 *= scale.x;

            mtx.m21 *= scale.y;
            mtx.m22 *= scale.y;
            mtx.m23 *= scale.y;

            mtx.m31 *= scale.z;
            mtx.m32 *= scale.z;
            mtx.m33 *= scale.z;

            mtx.m41 = pos.x;
            mtx.m42 = pos.y;
            mtx.m43 = pos.z;

            return mtx;
        }
    }

    Mat4 WorldToLocalMatrix
    {
        get
        {
            Vec3 pos = -Position;
            Quat rot = Rotation.Inverse;
            Vec3 scale = Vec3.One.Divide(Scale);

            Mat4 mtxInv = Mat4.FromMat3(rot.ToMatrix());

            mtxInv.m11 *= scale.x;
            mtxInv.m12 *= scale.x;
            mtxInv.m13 *= scale.x;

            mtxInv.m21 *= scale.y;
            mtxInv.m22 *= scale.y;
            mtxInv.m23 *= scale.y;

            mtxInv.m31 *= scale.z;
            mtxInv.m32 *= scale.z;
            mtxInv.m33 *= scale.z;

            mtxInv.m41 = (pos.x * mtxInv.m11) + (pos.y * mtxInv.m21) + (pos.z * mtxInv.m31);
            mtxInv.m42 = (pos.x * mtxInv.m12) + (pos.y * mtxInv.m22) + (pos.z * mtxInv.m32);
            mtxInv.m43 = (pos.x * mtxInv.m13) + (pos.y * mtxInv.m23) + (pos.z * mtxInv.m33);

            return mtxInv;
        }
    }

    Node Parent {
        get { return parent; }
        set { SetParent(value, true); }
    }

    Scene ParentScene
    {
        get { return scene; }
        set
        {
            if(scene != value)
            {
                if(scene)
                    DetachFromScene();

                if(value != null)
                    AttachToScene(value);
            }
        }
    }

    List<Node> Children {
        get { return children; }
    }

    void AddChild(Node child) {
        child.Parent = this;
    }

    Node NewChild() {
        Node child = new Node{};
        child.Parent = this;
        return child;
    }

    void RemoveChild(Node child)
    {
        if(child.Parent == this)
            child.Parent = null;
    }

    void ClearChildren()
    {
        while(children.Count != 0)
        {
            Node child = children[children.Count - 1];
            child.Parent = null;
        }
    }

    void SignalStructureChanged()
    {
        Node node = this;

        while(node != null)
        {
            for(int i = 0; i != components.Count; ++i)
                components[i].OnStructureChanged();

            node = node.parent;
        }
    }

    void SetParent(Node newParent, bool preserveWorldTransform)
    {
        Node oldParent = parent;

        if(newParent == oldParent)
            return;

        Scene oldParentScene = ParentScene;
        if(oldParentScene)
            DetachFromScene();

        if(oldParent)
        {
            if(preserveWorldTransform)
            {
                Vec3 parentScale = oldParent.Scale;
                Quat parentRot = oldParent.Rotation;

                localPos = localPos.Multiply(parentScale);
                localPos *= parentRot;
                localPos += oldParent.Position;

                localRot = localRot * parentRot;

                localScale = localScale.Multiply(parentScale);
            }

            oldParent.children.Remove(this);
            oldParent.SignalStructureChanged();
        }

        parent = newParent;

        if(newParent)
        {
            if(preserveWorldTransform)
            {
                Quat invParentRot = newParent.Rotation.Inverse;
                Vec3 invParentScale = Vec3.One.Divide(newParent.Scale);

                localPos -= newParent.Position;
                localPos *= invParentRot;
                localPos = localPos.Multiply(invParentScale);

                localRot = localRot * invParentRot;

                localScale = localScale.Multiply(invParentScale);
            }

            newParent.children.Add(this);

            Scene newParentScene = newParent.ParentScene;
            if(newParentScene)
                AttachToScene(newParentScene);
        }

        SetDirty();
        SignalStructureChanged();
    }

    void AttachToScene(Scene newScene)
    {
        scene = newScene;

        if(scene)
        {
            for(int i = 0; i != components.Count; ++i)
            {
                var c = components[i];
                scene.RegisterComponent(c);
                c.OnAttachedToScene();
            }
        }

        for(int i = 0; i != children.Count; ++i)
            children[i].AttachToScene(scene);
    }

    void DetachFromScene()
    {
        if(scene)
        {
            for(int i = 0; i != components.Count; ++i)
            {
                var c = components[i];
                c.OnDetachFromScene();
                scene.UnregisterComponent(c);
            }
        }

        scene = null;

        for(int i = 0; i != children.Count; ++i)
            children[i].DetachFromScene();
    }

    IComponent AddComponent(IComponent comp)
    {
        Node oldOwner = comp.GetOwner();
        Node newOwner = this;

        if(oldOwner != newOwner)
        {
            if(oldOwner)
                oldOwner.RemoveComponent(comp);

            comp.SetOwner(newOwner);
            components.Add(comp);

            if(scene) {
                scene.RegisterComponent(comp);
                comp.OnAttachedToScene();
            }

            SignalStructureChanged();
        }

        return comp;
    }

    void RemoveComponent(IComponent comp)
    {
        Node owner = comp.GetOwner();

        if(owner == this)
        {
            if(scene) {
                comp.OnDetachFromScene();
                scene.UnregisterComponent(comp);
            }
            
            components.Remove(comp);
            comp.SetOwner(null);

            SignalStructureChanged();
        }
    }

    Node FindByName(string nodeName)
    {
        if(name == nodeName)
            return this;

        for(int i = 0; i != children.Count; ++i)
        {
            Node n = children[i].FindByName(nodeName);
            if(n != null)
                return n;
        }
        
        return null;
    }

    private void GetAllComponents<T>(List<T> out_components)
    {
        for(int i = 0; i != components.Count; ++i)
        {
            var comp = components[i];

            if(comp is T)
                out_components.Add(comp as T);
        }
        
        for(int i = 0; i != children.Count; ++i)
        {
            children[i].GetAllComponents<T>(out_components);
        }
    }

    List<T> GetAllComponents<T>()
    {
        List<T> components = new List<T>{};
        GetAllComponents<T>(components);
        return components;
    }

    T GetComponent<T>()
    {
        for(int i = 0; i != components.Count; ++i)
        {
            var comp = components[i];

            if(comp is T)
                return comp as T;
        }

        for(int i = 0; i != children.Count; ++i)
        {
            var comp = children[i].GetComponent<T>();
            if(comp != null)
                return comp as T;
        }

        return null;
    }
}
