enum DrawMode
{
    Points,
    Lines,
    LineStrip,
    Triangles,
    TriangleStrip
}

enum CullMode
{
    Off,
    Back,
    Front,
}

enum DepthTest
{
    Never,
    Less,
    Equal,
    LessOrEqual,
    Greater,
    NotEqual,
    GreaterOrEqual,
    Always
}

enum BlendFactor
{
    Zero,
    One,
    SrcColor,
    OneMinusSrcColor,
    DstColor,
    OneMinusDstColor,
    SrcAlpha,
    OneMinusSrcAlpha,
    DstAlpha,
    OneMinusDstAlpha,
    SrcAlphaSaturate,
    ConstColor,
    OneMinusConstColor,
    Src1Color,
    OneMinusSrc1Color,
    Src1Alpha,
    OneMinusSrc1Alpha
}

enum BlendOperation
{
    Add,
    Subtract,
    ReverseSubtract,
    Min,
    Max,
}

struct Color
{
    num r;
    num g;
    num b;
    num a;

    static Color Clear { get { return new Color{ 0.0, 0.0, 0.0, 0.0 }; } }
    static Color Black { get { return new Color{ 0.0, 0.0, 0.0, 1.0 }; } }
    static Color White { get { return new Color{ 1.0, 1.0, 1.0, 1.0 }; } }
    static Color Red   { get { return new Color{ 1.0, 0.0, 0.0, 1.0 }; } }
    static Color Green { get { return new Color{ 0.0, 1.0, 0.0, 1.0 }; } }
    static Color Blue  { get { return new Color{ 0.0, 0.0, 1.0, 1.0 }; } }
}

struct IntRect
{
    int x;
    int y;
    int w;
    int h;
}

extern class NativeGraphics
{
    extern this();
    extern void SetRenderTarget(object windowObj);
    extern void SetShader(object shaderObj);
    extern void SetVertexBuffer(object bufferObj);
    extern void SetIndexBuffer(object bufferObj);
    extern void SetClearColor(Color color);
    extern void SetViewport(IntRect rect);
    extern IntRect GetViewport();
    extern void SetCullMode(CullMode mode);
    extern void SetScissorTestEnabled(bool enabled);
    extern void SetScissorRect(IntRect rect);
    extern void SetDepthTest(DepthTest test);
    extern void SetDepthWriteEnabled(bool enabled);
    extern void SetBlendingEnabled(bool enabled);
    extern void SetBlendOperations(BlendOperation colorBlendOp, BlendOperation alphaBlendOp);
    extern void SetBlendFactors(BlendFactor sourceColor, BlendFactor destColor, BlendFactor sourceAlpha, BlendFactor destAlpha);
    extern void SetColorMask(bool red, bool green, bool blue, bool alpha);
    extern void SetBlendColor(Color color);
    extern void Clear();
    extern void Present();
    extern void DrawArray(int start, int count, DrawMode mode);
    extern void DrawIndexed(int start, int count, DrawMode mode);
}

class Graphics
{
    private NativeGraphics nativeGraphics;

    private Shader currentShader;
    private Buffer currentBuffer;

    static Graphics Current = null;

    object NativeHandle {
		get { return nativeGraphics; }
	}

    this() {
        nativeGraphics = new NativeGraphics{};
    }

    void SetRenderTarget(Window window) {
        nativeGraphics.SetRenderTarget(window.NativeHandle);
    }

    void SetShader(Shader shader)
    {
        nativeGraphics.SetShader(shader.NativeHandle);
        currentShader = shader;  // prevent GC
    }

    void SetVertexBuffer(Buffer buffer)
    {
        nativeGraphics.SetVertexBuffer(buffer.NativeHandle);
        currentBuffer = buffer;  // prevent GC
    }

    void SetIndexBuffer(Buffer buffer)
    {
        nativeGraphics.SetIndexBuffer(buffer.NativeHandle);
        currentBuffer = buffer;  // prevent GC
    }

    void SetClearColor(Color color) {
        nativeGraphics.SetClearColor(color);
    }

    IntRect Viewport
    {
        get { return nativeGraphics.GetViewport(); }
        set { nativeGraphics.SetViewport(value); }
    }

    void SetCullMode(CullMode mode) {
        nativeGraphics.SetCullMode(mode);
    }

    void SetScissorTestEnabled(bool enabled) {
        nativeGraphics.SetScissorTestEnabled(enabled);
    }

    void SetScissorRect(IntRect rect) {
        nativeGraphics.SetScissorRect(rect);
    }

    void SetDepthTest(DepthTest test) {
        nativeGraphics.SetDepthTest(test);
    }

    void SetDepthWriteEnabled(bool enabled) {
        nativeGraphics.SetDepthWriteEnabled(enabled);
    }

    void SetBlendingEnabled(bool enabled) {
        nativeGraphics.SetBlendingEnabled(enabled);
    }

    void SetBlendOperations(BlendOperation colorBlendOp, BlendOperation alphaBlendOp) {
        nativeGraphics.SetBlendOperations(colorBlendOp, alphaBlendOp);
    }

    void SetBlendFactors(BlendFactor sourceColor, BlendFactor destColor, BlendFactor sourceAlpha, BlendFactor destAlpha) {
        nativeGraphics.SetBlendFactors(sourceColor, destColor, sourceAlpha, destAlpha);
    }

    void SetBlendFactors(BlendFactor sourceFactor, BlendFactor destFactor) {
        nativeGraphics.SetBlendFactors(sourceFactor, destFactor, sourceFactor, destFactor);
    }

    void SetColorMask(bool red, bool green, bool blue, bool alpha) {
        nativeGraphics.SetColorMask(red, green, blue, alpha);
    }

    void SetBlendColor(Color color) {
        nativeGraphics.SetBlendColor(color);
    }

    void Clear() {
        nativeGraphics.Clear();
    }

    void Present() {
        nativeGraphics.Present();
    }

    void DrawArray(int start, int count, DrawMode mode) {
        nativeGraphics.DrawArray(start, count, mode);
    }

    void DrawIndexed(int start, int count, DrawMode mode) {
        nativeGraphics.DrawIndexed(start, count, mode);
    }
}
