extern class NativeShader
{
    extern this(object graphicsObj, string src, string vertexEntry, string pixelEntry);
    extern void SetUniformMat4(string name, Mat4 value);
    extern void SetUniformTex(string name, object textureObj);
}

class Shader
{
    private NativeShader nativeShader;
    
    extern static Task<NativeShader> CreateNativeShaderAsync(object graphicsObj, string src, string vertexEntry, string pixelEntry);

    this(Graphics graphics, string src, string vertexEntry, string pixelEntry) {
        nativeShader = new NativeShader{graphics.NativeHandle, src, vertexEntry, pixelEntry};
    }

    void SetUniform(string name, Mat4 value) {
        nativeShader.SetUniformMat4(name, value);
    }

    void SetUniform(string name, Texture value) {
        nativeShader.SetUniformTex(name, value.NativeHandle);
    }

    static Task<Shader> CreateShaderAsync(Graphics graphics, string src, string vertexEntry, string pixelEntry)
    {
        NativeShader newNativeShader = await Shader.CreateNativeShaderAsync(graphics.NativeHandle, src, vertexEntry, pixelEntry);
        return new Shader{ newNativeShader };
    }

    object NativeHandle {
        get { return nativeShader; }
    }
}
